<?xml version="1.0"?>
<package format="3">
  <name>gazebo_scripts</name>
  <version>0.0.0</version>
  <description>Gazebo simulation plugins and utilities for quadruped robots (ROS2).</description>

  <maintainer email="vvasilo@seas.upenn.edu">vasilisvasilop</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>quad_msgs</depend>
  <depend>quad_utils</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>urdf</depend>
  <depend>angles</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>realtime_tools</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/spirit_controller_plugin.xml"/>
  </export>
</package>
